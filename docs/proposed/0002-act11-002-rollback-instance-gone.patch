+/// What the kernel does with the pid init's `stop` acknowledgement names
+/// when it rolls a retry back (ACT11-002).
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum RollbackKill {
+    /// A live instance of the service: the kernel kills it.
+    Kill,
+    /// Nothing is left to kill: the named process has already ended, or is
+    /// no longer in the table. Not a refusal - no authority is in question
+    /// when there is no process to use it on.
+    Gone,
+    /// A live process that is not an instance of the service. init holds no
+    /// kill authority and must not gain any through the mailbox.
+    Refuse,
+}
+
+/// Decide the rollback kill from what the process table says about the pid.
+///
+/// `present`: the pid is in the table. `terminal`: it has ended (exited,
+/// faulted or was killed). `instance`: it is a child of the live init running
+/// the program `/etc/init.conf` names for the service.
+///
+/// A service that exits by itself (`flapd` always does) can end between
+/// init's acknowledgement and the kernel reading it; that is `Gone`, and it
+/// used to be reported as a refusal (`not_an_instance`) on roughly every
+/// other run. The refusal is kept for the one case that is about authority:
+/// a live process init had no business naming.
+pub const fn rollback_kill(present: bool, terminal: bool, instance: bool) -> RollbackKill {
+    if !present || terminal {
+        RollbackKill::Gone
+    } else if instance {
+        RollbackKill::Kill
+    } else {
+        RollbackKill::Refuse
+    }
+}
