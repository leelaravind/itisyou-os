 #[cfg(test)]
 mod tests {
     use super::*;
 
+    #[test]
+    fn rollback_kills_only_a_live_instance() {
+        // present, terminal, instance
+        assert_eq!(rollback_kill(true, false, true), RollbackKill::Kill);
+        // A live process that is not an instance is never killed on init's word.
+        assert_eq!(rollback_kill(true, false, false), RollbackKill::Refuse);
+        // An instance that ended by itself: nothing to kill, not a refusal.
+        assert_eq!(rollback_kill(true, true, true), RollbackKill::Gone);
+        assert_eq!(rollback_kill(true, true, false), RollbackKill::Gone);
+        // Reaped, or never existed.
+        assert_eq!(rollback_kill(false, false, false), RollbackKill::Gone);
+        assert_eq!(rollback_kill(false, true, true), RollbackKill::Gone);
+        // Kill is reachable only as live + instance.
+        for present in [false, true] {
+            for terminal in [false, true] {
+                for instance in [false, true] {
+                    let kill = rollback_kill(present, terminal, instance) == RollbackKill::Kill;
+                    assert_eq!(kill, present && !terminal && instance);
+                }
+            }
+        }
+    }
