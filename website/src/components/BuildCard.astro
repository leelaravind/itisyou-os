---
/**
 * Live build card — every field comes from status/current.json via the sync
 * script. Absent evidence renders as an honest "—" / NOT YET VERIFIED state.
 */
import { status, orDash } from '../lib/status';
import StatusTag from './StatusTag.astro';

interface Props {
  class?: string;
}
const { class: extraClass } = Astro.props;

const fields = [
  { label: 'VERSION', value: `v${status.version}` },
  { label: 'MATURITY', value: status.maturity },
  { label: 'MILESTONE', value: status.milestone },
  { label: 'ARCH', value: status.architecture },
  { label: 'ENVIRONMENT', value: `${status.environment} (BIOS + UEFI/OVMF)` },
  { label: 'COMMIT', value: orDash(status.commit) },
  { label: 'LAST VERIFIED', value: orDash(status.lastVerifiedAt) },
];
---

<article class:list={['panel', extraClass]} aria-labelledby="build-card-title">
  <div class="flex flex-wrap items-center justify-between gap-3 border-b border-line px-gutter py-4">
    <h3 id="build-card-title" class="font-mono text-mono-label text-ink uppercase tracking-widest">
      Current Build
    </h3>
    <StatusTag status={status.verification} />
  </div>
  <dl class="grid grid-cols-2 md:grid-cols-3 gap-px bg-line">
    {
      fields.map((field) => (
        <div class="bg-surface px-4 py-4">
          <dt class="font-mono text-status-tag text-muted uppercase tracking-widest mb-2">{field.label}</dt>
          <dd class="font-mono text-mono-data text-ink break-words">{field.value}</dd>
        </div>
      ))
    }
    <div class="bg-log px-4 py-4 col-span-2 md:col-span-1">
      <dt class="font-mono text-status-tag text-muted uppercase tracking-widest mb-2">TRUTH SOURCE</dt>
      <dd class="font-mono text-mono-data text-meta">status/current.json</dd>
    </div>
  </dl>
  <p class="font-mono text-mono-data text-muted border-t border-line px-gutter py-3">
    Fields marked “—” have no verification evidence yet and are reported as absent rather than estimated.
  </p>
</article>
