---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { status } from '../lib/status';
import { RELEASES } from '../lib/releases';
import downloads from '../data/downloads.json';

const latestRelease = RELEASES[0];

const description =
  'Frequently asked questions about ITISYOU OS: what it is, what it is not, whether you can install it (no), how verification works, and where the source and release evidence are.';

interface Faq {
  q: string;
  tag: string;
  a: string[];
}
interface FaqSection {
  id: string;
  title: string;
  items: Faq[];
}

const sections: FaqSection[] = [
  {
    id: 'general',
    title: 'General',
    items: [
      {
        q: 'Is this a Linux distribution?',
        tag: 'CORE',
        a: [
          'No. ITISYOU OS is an independent x86_64 kernel written in Rust (no_std). It contains no Linux kernel code at runtime and no GNU userland. It boots through the rust-osdev bootloader crate, not through a Linux boot chain.',
        ],
      },
      {
        q: 'Is it better than Linux?',
        tag: 'CORE',
        a: [
          'No, and it does not claim to be. Linux is a mature, production-proven kernel ecosystem. ITISYOU OS is a research project testing different hypotheses — explicit authority boundaries, evidence-gated development, recoverability as architecture — for a constrained personal-computing target.',
        ],
      },
      {
        q: 'What actually works today?',
        tag: 'STATUS',
        a: [
          `The project is ${status.maturity} at v${status.version}, milestone “${status.milestone}”. Verified in QEMU so far: the V0.1 kernel foundation; V0.2 Ring 3 userspace; V0.3 per-process isolation, concurrent processes and strict process isolation; V0.4 preemptive multitasking plus persistent storage; V0.5 a real graphical desktop (ownership-isolated windows, GUI syscalls, PS/2 keyboard + mouse); V0.6 hardware foundations (device model + UHCI HID + AC97 + unified input); V0.7 platform controls: capability default deny, sandboxed fs visibility, service supervision, manifest-launch apps, and atomic update+rollback with reboot recovery; and V0.8 networking (e1000 with ARP/IPv4/ICMP/UDP/DNS and port-scoped socket capabilities), Ed25519 package signatures, capability-scoped userspace filesystem writes, APIC/MSI-X interrupt delivery, xHCI enumeration and HID input, a hash-chained audit trail that survives reboots, and SMEP/SMAP/UMIP; and V0.9 (released as v0.9.0): TCP from Ring 3 verified against the host’s own TCP stack, a DHCP client, IPv6 foundations, the I/O APIC cutover with the 8259 PIC retired, ACPI power-off, a package-signing key hierarchy under an offline root, audit anchoring off the disk, and guard pages under the kernel’s RSP0 (Ring 3 interrupt) and double-fault stacks; and V0.10 (released as v0.10.0): background programs that keep running while the console is busy, a process tree, /sbin/init as pid 1 from /etc/init.conf, a Ring 3 shell, program arguments, filesystem space reclamation, and Ring 3 desktop apps with click-to-focus and routed input. The latest release is ${latestRelease.tag}; the download page serves the ${downloads.tag} boot images for virtual machines. v1.0.0 also carries the V0.11 AI-Native System Layer (folded in — it was never tagged on its own): a read-only system view served only to a process the console grants it, a small diagnostic model trained at build time from synthetic scenarios (its accuracy equals a one-rule baseline), the inference service inferd in Ring 3, a diagnostic agent with no authority to act, kernel-checked proposals, approval only at the console, and two actions the kernel executes, verifies and rolls back. V1.0 itself is reliability and security: IPC authority scoped to named channels, a Ring 3 syscall fuzzer and a decoder mutation fuzzer that found real panics, long-use leak accounting, contained CPU exceptions, and a whole-attack-surface adversarial review (37 findings, each checked by an independent refuter) that fixed every high-severity defect and 18 findings in all, with seven documented accepted fail-closed availability limits remaining. v1.0.0 is verified locally — not by GitHub CI (the repository is private with no Actions minutes), so it carries no CI run id — by the full local QEMU matrix, two-clean-build reproducibility, and boot-tests; the CI-dependent acceptance rows are recorded BLOCKED on the CI window. The build page shows the live evidence-backed module table.`
        ],
      },
    ],
  },
  {
    id: 'hardware',
    title: 'Hardware',
    items: [
      {
        q: 'Can I install it on my laptop?',
        tag: 'HARDWARE',
        a: [
          'No — please don’t. The OS runs exclusively inside QEMU (BIOS and UEFI via OVMF) with project-generated disposable disk images. Physical-hardware boot is intentionally out of scope and untested, and the project’s own safety rules forbid pointing it at a real disk. Real hardware appears on the roadmap only for explicitly approved sacrificial devices, much later.',
        ],
      },
      {
        q: 'What hardware does it support?',
        tag: 'HARDWARE',
        a: [
          'A QEMU-only execution target: x86_64 BIOS/UEFI on QEMU’s pc machine, single CPU, NVMe storage, PS/2 plus UHCI and xHCI USB keyboard input, AC97 audio output and an e1000 network adapter, as currently verified. It does not claim general desktop/laptop hardware coverage.',
        ],
      },
    ],
  },
  {
    id: 'technical',
    title: 'Technical',
    items: [
      {
        q: 'Why Rust?',
        tag: 'DESIGN',
        a: [
          'The kernel targets memory-safety discipline, testability and a minimal trusted computing base. Rust (no_std, x86_64-unknown-none) removes whole classes of memory errors by construction, keeps unsafe blocks localized and documented, and lets pure kernel logic be unit-tested on the host — the same code that runs in QEMU. See ADR-0001 in the repository.',
        ],
      },
      {
        q: 'What does “Verified” mean on this site?',
        tag: 'PROCESS',
        a: [
          'A status becomes Verified only when an actual automated run proves it: the QEMU harness requires every expected boot-stage marker, an in-kernel selftest summary with zero failures, and a deterministic exit code — with serial logs and JSON results retained as evidence. “Implemented” (code exists) and “Verified” (evidence exists) are never interchangeable.',
        ],
      },
      {
        q: 'How does the boot sequence work?',
        tag: 'KERNEL',
        a: [
          'The rust-osdev bootloader hands the kernel a typed BootInfo (memory map, physical-memory mapping offset, framebuffer, RSDP). The kernel then walks a fixed stage contract, B000 through B150, emitting one machine-parseable serial marker per stage — the same contract the test harness asserts.',
        ],
      },
    ],
  },
  {
    id: 'security',
    title: 'Security',
    items: [
      {
        q: 'What does “AI has intelligence, not authority” mean?',
        tag: 'PRINCIPLE',
        a: [
          'An AI layer may reason about the system and propose actions, but it never executes privileged kernel operations directly. Proposals flow through a deterministic pipeline — policy engine, risk/permission evaluation, user approval, a narrow privileged service — followed by verification, audit and rollback. Released images before v1.0.0 contain no AI component; the principle came first because it constrains kernel interface design.',
          'v1.0.0 ships the first agent, which works this way. It reads an approved, read-only view of system state and asks a small model running in Ring 3 for a diagnosis. It may then file a proposal, which the kernel accepts only if it matches what the kernel knows itself: the shipped model, the view it served that agent, its own recomputation of the diagnosis and the current state of the system. Only an operator at the kernel console can approve it; the kernel then runs the action, checks that it worked and rolls it back if not. There are two actions, resume the scheduler and retry a failed service, and the agent cannot perform either itself.',
        ],
      },
      {
        q: 'Is it secure?',
        tag: 'HONESTY',
        a: [
          'The platform is not production hardened, but V0.7, V0.8 and V0.9 moved core trust controls into tested enforcement: default-deny capabilities as revocable handles re-checked on every use, filesystem sandboxing by normalized prefixes, deterministic service mediation, auditable denials, atomic update/rollback/recovery, crash containment, Ed25519 package authenticity, a hash-chained audit trail that survives reboots, and SMEP/SMAP/UMIP enforcing kernel/user separation in the CPU. v0.9.0 narrowed the gaps v0.8.1 carried — a published development signing key with no rotation or revocation, an audit chain blind to a whole-file rewrite, line IRQs on the legacy PIC — with an offline-root key hierarchy (scoped certificates, signed revocation), audit anchoring off the disk (an explicit command), and the I/O APIC cutover; it added TCP, DHCP and IPv6 foundations as new attack surface, guard pages under the kernel’s RSP0 (Ring 3 interrupt) and double-fault stacks, and a fix for a kernel panic any program could trigger with a null pointer and a zero length. v0.10.0 put the syscall stack and the kernel task stacks on guard pages too, and fixed a denial of service in every earlier release (the kernel wrote through user pages the program could not write). Found after v0.10.0 and fixed in v1.0.0: three audit-trail defects present since v0.8.0, disclosed on the security page. v1.0.0 also ran a whole-attack-surface adversarial review (37 findings, each checked by an independent refuter) that fixed every high-severity defect and 18 findings in all — unhandled CPU exceptions a Ring 3 program could turn into a kernel panic, a package launched outside its signing key’s scope, an ICMP responder a remote ping flood could recurse into the stack guard — with seven documented, accepted, fail-closed availability limits remaining; and it is verified locally, not by GitHub CI (private repo, no Actions minutes). Remaining gaps, stated plainly: the boot image itself is not authenticated, so whoever can rewrite it can replace the trust root; there is no persistent anti-rollback floor for revocation lists across boots; TCP initial sequence numbers are not keyed; and there is no Secure Boot or measured boot. The AI layer’s own limits: its model is trained on synthetic data, IPC carries no sender identity, and proposals are held only in memory.',
        ],
      },
    ],
  },
  {
    id: 'contribution',
    title: 'Source & Contribution',
    items: [
      {
        q: 'Where is the source code?',
        tag: 'ACCESS',
        a: [
          'The source repository is private. It has been made public only briefly, so that GitHub CI could run for releases, and the owner decides when it opens. Published releases, their checksums and the engineering evidence are on this site: the releases and download pages, the engineering documentation, the status data and the development ledger.',
        ],
      },
      {
        q: 'Can I contribute?',
        tag: 'ACCESS',
        a: [
          'Not at present: the source repository is private. The engineering groundwork is public here: architecture, security model, testing strategy, roadmap and known limitations.',
        ],
      },
    ],
  },
];
---

<Base title="FAQ" description={description}>
  <div class="max-w-(--container-max) mx-auto px-4 sm:px-margin pt-12 pb-8">
    <header class="panel p-gutter md:p-margin mb-margin">
      <Breadcrumbs class="mb-4" crumbs={[{ label: 'SYSTEM', href: '/' }, { label: 'FAQ' }]} />
      <h1 class="font-sans font-light text-[36px] sm:text-display-lg text-ink mb-2">FAQ / System Queries</h1>
      <p class="font-mono text-mono-data text-meta-bright">
        v{status.version} // answers reflect the current evidence-backed state, nothing more
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-gutter">
      <aside class="md:col-span-3 md:border-r md:border-line md:pr-gutter hidden md:block">
        <nav class="sticky top-[89px] flex flex-col gap-1" aria-label="FAQ categories">
          <p class="font-mono text-mono-label text-muted mb-4 uppercase tracking-widest">Categories</p>
          {
            sections.map((section) => (
              <a
                href={`#${section.id}`}
                class="font-mono text-mono-label text-meta hover:text-ink border-l-2 border-transparent hover:border-line-strong pl-4 py-2.5 transition-colors"
              >
                {section.title}
              </a>
            ))
          }
        </nav>
      </aside>

      <div class="md:col-span-9 flex flex-col gap-12">
        {
          sections.map((section) => (
            <section class="scroll-mt-24" id={section.id} aria-labelledby={`${section.id}-title`}>
              <div class="flex items-center gap-3 mb-6 border-b border-line pb-2">
                <h2 id={`${section.id}-title`} class="font-sans text-headline-md text-ink">
                  {section.title}
                </h2>
              </div>
              <div class="flex flex-col gap-3">
                {section.items.map((item) => (
                  <details class="panel group">
                    <summary class="flex items-center justify-between gap-4 p-5 sm:p-6 cursor-pointer hover:bg-surface-2 transition-colors list-none [&::-webkit-details-marker]:hidden min-h-11">
                      <span class="text-body-base text-body">{item.q}</span>
                      <span class="flex items-center gap-4 shrink-0">
                        <span class="border border-line-soft px-2 py-1.5 font-mono text-[10px] font-bold tracking-widest text-muted uppercase hidden sm:inline">
                          {item.tag}
                        </span>
                        <span aria-hidden="true" class="font-mono text-meta group-open:hidden">
                          +
                        </span>
                        <span aria-hidden="true" class="font-mono text-meta hidden group-open:inline">
                          −
                        </span>
                      </span>
                    </summary>
                    <div class="bg-log border-t border-line p-5 sm:p-6">
                      {item.a.map((para) => (
                        <p class="text-body-base text-meta-bright mb-3 last:mb-0 max-w-3xl">{para}</p>
                      ))}
                    </div>
                  </details>
                ))}
              </div>
            </section>
          ))
        }
      </div>
    </div>
  </div>
</Base>
