---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import StatusTag from '../components/StatusTag.astro';

const description =
  'ITISYOU OS security and authority model: AI has intelligence, not authority. Trust boundaries, the capability-handle model enforced at the syscall boundary, package authenticity, hardening, and the threat model.';

const boundaries = [
  {
    n: 1,
    name: 'Firmware/bootloader boundary',
    now: true,
    text: 'SeaBIOS/OVMF + the rust-osdev bootloader run before the kernel; boot-provided data (memory map, framebuffer, RSDP) is validated before broad use. Boot-time-only code is not part of the OS runtime.',
  },
  {
    n: 2,
    name: 'Kernel trusted boundary',
    now: true,
    text: 'All Rust no_std code in kernel/ — the trusted computing base.',
  },
  {
    n: 3,
    name: 'Userspace boundary',
    now: true,
    text: 'V0.5, verified: concurrent, preemptively-scheduled ring 3 processes, each in its own address space (per-process page tables — cross-process memory isolation is MMU-enforced and machine-checked). A non-yielding process cannot monopolize the CPU. Syscall arguments validated against the active address space before any kernel dereference; no user mapping of kernel pages; faults contained to the faulting process. The screen is isolated too: a ring 3 program reaches the framebuffer only through validated GUI syscalls, and the compositor rejects any draw outside a process’s own window (ownership + bounds enforced, machine-checked). Hardware follows the same rule (V0.6): applications get device information only through a device-info syscall — all PCI config, MMIO, and port I/O stay in the kernel, never exposed to Ring 3.',
  },
  {
    n: 4,
    name: 'Privileged system-service boundary',
    now: true,
    text: 'V0.7, verified: system services are ordinary ring 3 processes supervised by the kernel with EXACTLY their declared capabilities — no hidden privileged daemons. Deterministic cycle-checked startup order, crash containment, a bounded restart policy (a crash-looping service is restarted 3 times then marked Failed), and a structured diagnostic marker per state transition.',
  },
  {
    n: 5,
    name: 'Untrusted application boundary',
    now: true,
    text: 'V0.7, verified: applications launch only through the platform, receiving manifest-requested capabilities intersected with the launcher’s (default deny) under a traversal-proof filesystem sandbox. Denied access is machine-verified as actually denied (a zero-capability probe must see all 7 privileged syscall classes refused), and every denial is audited.',
  },
  {
    n: 6,
    name: 'AI/agent boundary',
    now: false,
    text: 'Future — but the V0.7 request → capability check → deterministic service → action → audit path IS the pipeline an agent will use; agents get no other entry point.',
  },
  {
    n: 7,
    name: 'External network boundary',
    now: true,
    text: 'V0.8, verified: an IPv4 stack (e1000, ARP, ICMP, UDP, DNS) that treats every received byte as hostile — parsers refuse what they do not fully understand, every drop is counted with a reason, and nothing received can grow kernel memory. It answers only ARP for its own address and ICMP echo; the harness sends five hostile frames and asserts the guest answers none of them. A Ring 3 program reaches the network only through a capability handle scoped to one port, re-checked on every call. No TCP, DHCP or IPv6 yet.',
  },
];

const threats = [
  ['Host damage from OS testing', 'misconfigured VM (disk passthrough, raw device writes)', 'QEMU launches only project-generated images; no passthrough flags anywhere in scripts/harness; physical-hardware boot is out of scope'],
  ['Kernel bug corrupting its own state silently', 'logic errors, bad unsafe', 'panic-on-invariant-violation; boot-stage markers; selftests; unsafe inventory'],
  ['Malformed boot data', 'firmware/bootloader handoff anomalies', 'validate memory map/pointers before use; reject overlapping regions'],
  ['Malformed initramfs', 'corrupt/hostile archive bytes', 'strict bounds-checked parsing with negative-case tests (planned with FS-001)'],
  ['Supply-chain drift', 'dependencies with unexpected code', 'small pinned dependency set, Cargo.lock committed, rationale per kernel dependency'],
  ['Secret leakage', 'tokens in commits/logs/CI', 'secret scan before pushes; env-var/platform secret stores only'],
  ['Fake completion', 'claims without evidence', 'requirement matrix + machine-readable QEMU evidence; website generated from status/current.json; the build fails when the kernel version, status metadata or requirement states disagree'],
  ['Hostile network input', 'malformed, spoofed or unsolicited frames', 'allocation-free parsers that refuse VLAN tags, fragments, bad checksums and every truncation; bounded ARP cache and socket queues; only ARP-for-us and ICMP echo are answered (verified with five hostile frames, zero replies)'],
  ['Tampered or foreign package', 'modified payload, unsigned or stranger-signed package, forged signature', 'SHA-256 integrity plus Ed25519 authenticity against a compiled-in trust root — four distinct refusals, verified; the trust root is still a published development key (V0.9: key hierarchy with rotation and revocation)'],
  ['Edited audit trail', 'records altered, deleted, reordered or inserted on disk', 'hash-chained records verified on every boot and reported TAMPERED; an attacker who rewrites the whole file including its head is not yet detected (V0.9: anchoring)'],
  ['Kernel touching user memory by accident', 'confused-deputy bugs, user pointers', 'SMAP forbids kernel access to user pages outside three declared windows; SMEP and UMIP on; W^X for user segments; a guard page below the user stack'],
];
---

<Base title="Security & Authority Model" description={description}>
  <div class="max-w-(--container-max) mx-auto px-4 sm:px-margin pt-12 pb-8 flex flex-col gap-16">
    <header class="border-b border-line-soft pb-12">
      <Breadcrumbs
        class="mb-6"
        crumbs={[{ label: 'SYSTEM', href: '/' }, { label: 'ARCHITECTURE', href: '/architecture' }, { label: 'SECURITY_POLICY' }]}
      />
      <h1 class="font-sans font-light text-[36px] sm:text-display-lg text-ink uppercase mb-6">
        System Security &amp;<br />Authority Model
      </h1>
      <p class="font-sans text-headline-md text-meta-bright max-w-2xl border-l-2 border-ink pl-4 py-1">
        AI has intelligence, not authority.
      </p>
    </header>

    <!-- ============ 01 authority boundaries ============ -->
    <section class="grid grid-cols-1 md:grid-cols-12 gap-gutter" aria-labelledby="s1-title">
      <div class="md:col-span-4 flex flex-col gap-4">
        <h2 id="s1-title" class="font-mono text-mono-label text-ink tracking-widest">01 // THE CENTRAL PRINCIPLE</h2>
        <p class="text-body-base text-meta-bright">
          Any future AI/agent layer reasons about the system and proposes actions; it never executes privileged kernel
          operations directly. The current runtime contains no AI component — the principle exists now because it
          constrains interface design: every privileged operation is reachable only through a narrow, deterministic,
          capability-checked and audited path, and an agent will get that path and nothing else.
        </p>
        <div class="log-block mt-4" aria-label="Intended authority pipeline">
          <p class="text-muted mb-2">// capability check, service and audit exist today; the agent layer is planned</p>
          <p>agent intent → policy engine</p>
          <p>&nbsp;&nbsp;→ risk/permission evaluation</p>
          <p>&nbsp;&nbsp;→ user approval (where required)</p>
          <p>&nbsp;&nbsp;→ deterministic privileged service</p>
          <p>&nbsp;&nbsp;→ kernel operation → verification</p>
          <p>&nbsp;&nbsp;→ audit → rollback/recovery</p>
        </div>
      </div>
      <div class="md:col-span-8 panel p-6 md:p-8 relative">
        <div class="absolute top-0 right-0 p-4"><StatusTag status="concept" /></div>
        <h3 class="font-sans text-headline-md text-ink mb-6 pr-24">Intelligence / authority separation</h3>
        <div class="flex flex-col md:flex-row gap-6 mt-4">
          <div class="flex-1 border border-line p-6 bg-log">
            <p class="font-mono text-mono-label text-meta border-b border-line pb-2 mb-4">FUTURE AI / AGENT LAYER</p>
            <ul class="font-mono text-mono-data text-meta space-y-2 list-none">
              <li>− no raw hardware access</li>
              <li>− no direct kernel calls</li>
              <li>− proposes, never executes</li>
            </ul>
          </div>
          <div class="flex items-center justify-center relative md:w-10 shrink-0 py-2" aria-hidden="true">
            <span class="hidden md:block absolute inset-y-0 left-1/2 w-px bg-red-deep"></span>
            <span class="font-mono text-red bg-surface px-1 z-10 text-sm">⊘</span>
          </div>
          <div class="flex-1 border border-ink p-6 bg-base">
            <p class="font-mono text-mono-label text-ink border-b border-ink pb-2 mb-4">DETERMINISTIC SYSTEM SIDE</p>
            <ul class="font-mono text-mono-data text-ink space-y-2 list-none">
              <li>+ policy &amp; permission evaluation</li>
              <li>+ narrow privileged services</li>
              <li>+ verification, audit, rollback</li>
            </ul>
          </div>
        </div>
        <p class="mt-6 border-t border-line pt-4 font-mono text-mono-data text-meta text-xs">
          Kernel APIs are designed so privileged operations can later sit behind this layer rather than being callable
          by an agent directly.
        </p>
      </div>
    </section>

    <!-- ============ 02 trust boundaries ============ -->
    <section aria-labelledby="s2-title">
      <h2 id="s2-title" class="font-mono text-mono-label text-ink tracking-widest mb-6">02 // TRUST BOUNDARIES</h2>
      <ol class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-px bg-line border border-line list-none">
        {
          boundaries.map((b) => (
            <li class="bg-surface p-6 flex flex-col gap-3">
              <div class="flex items-center justify-between gap-3">
                <span class="font-mono text-mono-label text-muted tracking-widest">BOUNDARY_{String(b.n).padStart(2, '0')}</span>
                <StatusTag status={b.now ? 'verified' : 'concept'} label={b.now ? 'Current' : 'Future'} />
              </div>
              <h3 class="font-sans text-body-base font-medium text-ink">{b.name}</h3>
              <p class="text-sm text-meta-bright">{b.text}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- ============ 03 controls in force now ============ -->
    <section class="grid grid-cols-1 md:grid-cols-12 gap-gutter" aria-labelledby="s3-title">
      <div class="md:col-span-4">
        <h2 id="s3-title" class="font-mono text-mono-label text-ink tracking-widest mb-4">03 // IN FORCE NOW</h2>
        <p class="text-body-base text-meta-bright">
          Each control below is enforced by the current build and exercised by a QEMU leg that must see the refusal
          happen — a control never observed failing is not counted. The environment is still a single-CPU virtual
          machine; nothing here is a claim about physical hardware.
        </p>
      </div>
      <ul class="md:col-span-8 flex flex-col gap-px bg-line border border-line list-none">
        {
          [
            ['CAPABILITY HANDLES', 'Every privileged syscall revalidates the caller’s handle in a kernel table — owner-bound, scoped to one resource (a port, a channel, a device), expiring, revocable. Forged, expired and revoked handles are each refused with the reason audited.'],
            ['DEFAULT DENY', 'A process holds nothing it was not granted and delegation only narrows: a zero-capability probe sees every privileged class refused, and a child can never hold what its parent lacked.'],
            ['SANDBOXED FILESYSTEM', 'Reads and writes are confined to per-process path prefixes checked on the normalized path; writing also needs the write right. Traversal and root escapes are refused.'],
            ['SIGNED PACKAGES', 'Installs verify SHA-256 integrity, then an Ed25519 signature against a compiled-in trust root. The current root is a published development key: the mechanism is verified, a real signer is not yet provisioned.'],
            ['CPU-ENFORCED SEPARATION', 'SMEP, SMAP and UMIP on; W^X for user segments; a guard page below the user stack; user pointers validated before any kernel dereference.'],
            ['AUDIT TRAIL', 'Every privileged action and every denial is recorded, hash-chained, persisted, and re-verified at boot — an edited trail is reported TAMPERED.'],
            ['VM CONTAINMENT', 'QEMU launches attach only project-generated disposable images; no host filesystem sharing and no disk passthrough (SEC-002). The test network is the harness’s own peer.'],
            ['UNSAFE MINIMIZED', 'unsafe localized and documented with invariants in docs/UNSAFE_INVENTORY.md; the kernel panics on a violated invariant rather than continuing corrupted.'],
          ].map(([label, text]) => (
            <li class="bg-surface p-5 flex flex-col sm:flex-row sm:items-start gap-3">
              <span class="font-mono text-mono-label text-ink tracking-widest sm:w-56 shrink-0">{label}</span>
              <p class="text-sm text-meta-bright">{text}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- ============ 04 threat model ============ -->
    <section aria-labelledby="s4-title">
      <div class="flex flex-wrap items-end justify-between gap-4 mb-6">
        <h2 id="s4-title" class="font-mono text-mono-label text-ink tracking-widest">04 // THREAT MODEL</h2>
        <p class="font-mono text-mono-data text-meta">
          Scoped to development reality: a pre-alpha OS running only inside QEMU.
        </p>
      </div>
      <div class="table-scroll panel mb-6">
        <table class="w-full border-collapse min-w-[720px]">
          <caption class="sr-only">Risks, vectors and mitigations</caption>
          <thead>
            <tr>
              {['Risk', 'Vector', 'Mitigation'].map((h) => (
                <th scope="col" class="text-left font-mono text-[11px] font-medium tracking-widest uppercase text-muted bg-log border-b border-line px-4 py-3">{h}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {
              threats.map((row) => (
                <tr class="border-b border-line last:border-b-0 align-top">
                  <td class="text-body-base text-ink px-4 py-3">{row[0]}</td>
                  <td class="text-sm text-meta-bright px-4 py-3">{row[1]}</td>
                  <td class="text-sm text-meta-bright px-4 py-3">{row[2]}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <div class="panel p-6">
        <h3 class="font-mono text-mono-label text-ink uppercase tracking-widest mb-3">Explicitly out of scope today</h3>
        <p class="text-body-base text-meta-bright max-w-3xl">
          Physical attacks, side channels, multi-core races (there is one CPU), malicious firmware, and an attacker who
          can rewrite the whole persistent disk including the audit trail’s stored head. Network input is in scope and
          treated as hostile; every milestone extends this model before its feature ships. The highest-value asset is
          still the host machine the VM runs on: the OS must never touch it.
        </p>
      </div>
    </section>

    <!-- ============ 05 capability model ============ -->
    <section class="panel p-gutter" aria-labelledby="s5-title">
      <div class="flex items-start justify-between gap-4 flex-wrap mb-4">
        <h2 id="s5-title" class="font-mono text-mono-label text-ink tracking-widest">05 // CAPABILITY MODEL</h2>
        <StatusTag status="verified" />
      </div>
      <div class="log-block mb-4" aria-label="Capability model shape">
        <p>subject → capability → object → permitted operation → constraints → provenance</p>
      </div>
      <p class="text-body-base text-meta-bright max-w-3xl">
        Explicit, inspectable, revocable, and narrower than blanket administrator privilege. Since V0.8 a capability is
        an opaque handle — an index plus a generation — into a kernel-owned table binding the owner, the resource
        scope, the rights and an optional expiry. Holding a handle number grants nothing: the table is consulted on
        every use, so revocation, expiry and narrowing take effect at the next call, and a handle presented by the
        wrong process is refused. Not yet present: a user-facing policy editor and capability kinds defined at run
        time.
      </p>
      <div class="mt-6 flex flex-wrap gap-4">
        <a href="/docs/security-model" class="btn btn-primary">Full security model</a>
        <a href="/docs/threat-model" class="btn">Full threat model</a>
      </div>
    </section>
  </div>
</Base>
