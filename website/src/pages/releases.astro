---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import StatusTag from '../components/StatusTag.astro';
import WarningBanner from '../components/WarningBanner.astro';
import { status } from '../lib/status';
import { RELEASES, type Release } from '../lib/releases';
import { MILESTONES } from '../lib/roadmap';
import downloads from '../data/downloads.json';

const description =
  'ITISYOU OS releases: every version tag with its commit and green CI run, what each delivered, and which carry a public, checksummed boot image for virtual machines (v0.8.1 is the first).';
const repo = 'https://github.com/leelaravind/itisyou-os';
/** The milestone in development, if any — built and verified, but not yet tagged. */
const building = MILESTONES.find((m) => m.current && m.status !== 'verified');
/**
 * A release's download link is shown only while its images are on the site:
 * the release /download serves (src/data/downloads.json), or an earlier one
 * whose published files are archived there.
 */
const downloadable = (r: Release) => r.tag === downloads.tag || r.archive !== undefined;
---

<Base title="Releases" description={description}>
  <div class="max-w-(--container-max) mx-auto px-4 sm:px-margin pt-12 pb-8 flex flex-col gap-gutter">
    <header class="border-b border-line-soft pb-gutter mb-4">
      <Breadcrumbs class="mb-4" crumbs={[{ label: 'SYSTEM', href: '/' }, { label: 'RELEASES' }]} />
      <h1 class="font-sans font-light text-[36px] sm:text-display-lg text-ink mb-2">System Releases</h1>
      <p class="font-mono text-mono-data text-meta-bright max-w-2xl">
        Early development builds are intended exclusively for VM environments. Releases are published only with
        verification evidence attached.
      </p>
    </header>

    <WarningBanner />

    <!-- ============ Tagged releases ============ -->
    <section class="panel" aria-labelledby="tags-title">
      <div class="p-gutter border-b border-line flex flex-wrap items-center justify-between gap-4">
        <h2 id="tags-title" class="font-sans text-headline-md text-ink">Version tags</h2>
        <div class="flex flex-wrap gap-2">
          <StatusTag status={status.maturity} />
          <StatusTag status={status.verification} />
        </div>
      </div>
      <p class="px-gutter pt-4 font-mono text-mono-data text-meta max-w-3xl">
        Each tag marks a commit whose full gate and CI run passed: evidence of a verified state. Since v0.8.1 a release
        can also carry a public download: boot images built by CI and published with their SHA-256 digests. Earlier
        tags have none. The latest release is {RELEASES[0].tag}; earlier images stay downloadable, unchanged.
      </p>
      {
        building?.release && (
          <p class="mx-gutter mt-4 font-mono text-mono-data text-meta-bright max-w-3xl border-l-2 border-line-strong pl-4">
            <span class="text-ink">NOT YET TAGGED // {building.id} — {building.name}.</span> {building.release}
          </p>
        )
      }
      <div class="table-scroll mt-4">
        <table class="w-full border-collapse min-w-[720px]">
          <caption class="sr-only">Release tags with commit, date, CI run and summary</caption>
          <thead>
            <tr>
              {['Tag', 'Milestone', 'Commit', 'Date', 'CI run', 'Delivered', 'Download'].map((h) => (
                <th scope="col" class="text-left font-mono text-[11px] font-medium tracking-widest uppercase text-muted bg-log border-b border-line px-4 py-3">{h}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {
              RELEASES.map((r) => (
                <tr class="border-b border-line last:border-b-0 align-top">
                  <td class="font-mono text-mono-data text-ink px-4 py-3 whitespace-nowrap">{r.tag}</td>
                  <td class="text-sm text-meta-bright px-4 py-3">{r.milestone}</td>
                  <td class="font-mono text-mono-data text-meta-bright px-4 py-3">{r.commit}</td>
                  <td class="font-mono text-mono-data text-meta-bright px-4 py-3 whitespace-nowrap">{r.date}</td>
                  <td class="font-mono text-mono-data text-meta-bright px-4 py-3">{r.ciRun}</td>
                  <td class="text-sm text-meta-bright px-4 py-3">{r.summary}</td>
                  <td class="font-mono text-mono-data px-4 py-3 whitespace-nowrap">
                    {r.download && downloadable(r) ? <a class="underline underline-offset-4 text-ink" href={r.download}>Images + SHA-256</a> : <span class="text-meta">—</span>}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="px-gutter py-4 font-mono text-mono-data text-meta border-t border-line">
        CI runs are GitHub Actions runs in the project repository ({repo}); the evidence is summarized in the
        requirement matrix. The commit column is the commit the listed CI run built; from v0.8.1 on that is the
        release’s content commit, and the tag sits on the status-stamp commit that follows it.
      </p>
    </section>

    <!-- ============ Release contract ============ -->
    <section class="grid grid-cols-1 md:grid-cols-12 gap-gutter mt-8" aria-labelledby="plan-title">
      <div class="md:col-span-5">
        <h2 id="plan-title" class="font-sans text-headline-md text-ink border-b border-line-soft pb-4 mb-6">
          What a release contains
        </h2>
        <p class="text-body-base text-meta-bright mb-4 max-w-prose">
          Since v0.8.1 a release publishes the boot images its CI run built and booted — never a local rebuild — under
          <span class="font-mono text-mono-data">/downloads/&lt;tag&gt;/</span>. Earlier tags carry no images.
        </p>
        <ul class="flex flex-col gap-2 font-mono text-mono-data text-meta-bright list-none">
          <li class="border border-line bg-log p-3">itisyou-os-&lt;version&gt;-x86_64-uefi.img — UEFI boot image (raw disk, GPT with an EFI system partition)</li>
          <li class="border border-line bg-log p-3">itisyou-os-&lt;version&gt;-x86_64-bios.img — BIOS boot image (raw disk, MBR)</li>
          <li class="border border-line bg-log p-3">SHA256SUMS.txt — the SHA-256 of both images, in the format sha256sum -c checks</li>
          <li class="border border-line bg-log p-3">on /download — the release commit, the CI run that built the images, where they were booted, reproducibility, known limitations</li>
        </ul>
      </div>
      <div class="md:col-span-7">
        <h2 class="font-sans text-headline-md text-ink border-b border-line-soft pb-4 mb-6">Release rules</h2>
        <ol class="flex flex-col gap-px bg-line border border-line list-none">
          {
            [
              ['EVIDENCE FIRST', 'A release is cut only from a commit whose full verification gate (build, host tests, the complete QEMU matrix, website, secret scan) passed locally and in CI — and the evidence ships with it.'],
              ['CHECKSUMS ALWAYS', 'Every artifact is listed in a SHA-256 manifest generated by the same build that produced it. Verify before booting.'],
              ['VIRTUAL MACHINES ONLY', 'Artifacts are disk images for virtual machines (QEMU is the tested environment). They are not installers, and no release targets physical hardware.'],
              ['VERSION MEANS VERSION', 'The kernel, the status metadata, the requirement matrix and the tag must name the same version — the build fails otherwise (added after v0.8.0 shipped a kernel reporting 0.7.0-dev).'],
              ['NO SILENT REPLACEMENT', 'Published artifacts are immutable; a fix means a new version, never an overwritten file.'],
            ].map(([label, text]) => (
              <li class="bg-surface p-5 flex flex-col sm:flex-row sm:items-start gap-3">
                <span class="font-mono text-mono-label text-ink tracking-widest sm:w-52 shrink-0">{label}</span>
                <p class="text-sm text-meta-bright">{text}</p>
              </li>
            ))
          }
        </ol>
        <div class="mt-6 flex flex-wrap gap-4">
          <a href="/build" class="btn btn-primary">Current build status</a>
          <a href="/changelog" class="btn">Changelog</a>
        </div>
      </div>
    </section>
  </div>
</Base>
